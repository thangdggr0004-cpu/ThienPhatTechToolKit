{
  "name": "thienphat-techtoolkit",
  "private": true,
  "version": "1.4.1",
  "description": "Thien Phat Tech Toolkit Pro",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite --port=3000 --strictPort --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron",
    "lint": "tsc --noEmit",
    "test": "npx tsx src/tests/runTests.ts",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run electron:build"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "systeminformation": "^5.23.2",
    "vite": "^6.2.3",
    "esbuild": "^0.20.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.20.2",
    "rimraf": "^4.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.thienphat.techtoolkit",
    "productName": "PCCareMasterPro",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "*.cjs"
    ],
    "extraResources": [
      "elevate.exe"
    ],
    "portable": {
      "artifactName": "PCCareMasterPro ${version}.exe",
      "requestExecutionLevel": "admin",
      "unpackDirName": "PCCareMasterCache",
      "useZip": false
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "certificateFile": "ThienPhatTech.pfx",
      "certificatePassword": "ThienPhat2026",
      "timeStampServer": "http://timestamp.digicert.com"
    },
    "publish": {
      "provider": "github",
      "owner": "thangdggr0004-cpu",
      "repo": "ThienPhatTechToolKit"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "@google/genai@2.12.0": true,
    "electron@28.3.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.20.2": true
  }
}
